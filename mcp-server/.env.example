# Shopify Admin API (custom app token: Settings > Apps > Develop apps)
SHOPIFY_STORE_DOMAIN=global-pest-supplies.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-07

# DSers partner API — only usable if/when you are an approved Supplier or Channel
# app (see dsers.dev). Leave blank to use the compliant CSV/JSON supplier-export
# workflow instead (find_products tool).
DSERS_APP_KEY=
DSERS_APP_SECRET=

# Safety gate: must be exactly "true" for import_approved_to_shopify / rollback_import
# to make live Shopify writes. Everything defaults to dry-run without this.
ALLOW_LIVE_WRITES=false

# Scoring assumptions — edit to match your real costs and fee structure.
MARKUP_MULTIPLIER=2.5
PAYMENT_FEE_PCT=0.029
PAYMENT_FEE_FIXED=0.30
BEST_SELLER_ORDER_THRESHOLD=500

# Where review-queue.json / change-log.jsonl are stored.
DATA_DIR=./data
# Root folder audit_site_ux scans for HTML files (defaults to cwd).
THEME_DIR=..
